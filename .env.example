# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Real Estate Agency Name
NEXT_PUBLIC_SITE_DESCRIPTION=Premium real estate platform for Nigerian properties
NEXT_PUBLIC_SITE_TAGLINE=Find Your Dream Property in Nigeria
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_LOGO_TEXT=RE

# Contact Information
NEXT_PUBLIC_WHATSAPP_NUMBER=234XXXXXXXXXX
NEXT_PUBLIC_PHONE_NUMBER=+234-XXX-XXX-XXXX
NEXT_PUBLIC_EMAIL=info@youragency.com

# Social Profiles (Optional; omitted from the footer when blank)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Cloudflare Turnstile
# Use Cloudflare's published test keys locally; use real widget keys only in deployment settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames only (no scheme/path), e.g. example.com,www.example.com
TURNSTILE_ALLOWED_HOSTNAMES=

# Google Maps (Optional)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Meta Pixel (Optional)
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX
